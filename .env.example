# Organizer-provided HTTPS origin. REST, MCP, and proxy traffic share this origin.
# Loopback development may still use ARENA_SERVER=127.0.0.1 with service ports.
ARENA_SERVER=https://gauntlet-practice.136.85.160.148.sslip.io

# Organizer-provided battle or practice key (from your approval email).
# Never commit the real value.
ARENA_API_KEY=

# Competitors do not need a separate provider key. The server-side proxy handles
# upstream OpenRouter access.

# Required. Pick a unique id, e.g. your team name (lowercase, hyphens).
# Practice is shared by every team: the examples refuse the kit's default id
# there, because another team's run with the same id would replace yours.
AGENT_ID=
AGENT_NAME=NemoSentinel

# Strategy settings live in my_strategy.py (its agent_id is used only when
# AGENT_ID is empty).
